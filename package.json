{
  "name": "cypress-framework-template",
  "version": "0.1.0",
  "description": "Production-style Cypress E2E framework with Page Object Model, scoped helper methods vs. global commands, cy.step() logging, @cypress/grep suite & environment tag filtering (#integration, #staging, #prod), and cypress-parallel execution.",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:parallel": "cypress-parallel -s cy:run -t 2 -d 'cypress/e2e/**/*.cy.js'",
    "cy:parallel:chrome": "cypress-parallel -s cy:run:chrome -t 2 -d 'cypress/e2e/**/*.cy.js'",
    "test": "cypress run",
    "test:local": "CYPRESS_BASE_URL=http://localhost:4200 CYPRESS_API_URL=http://localhost:8091 npm run cy:parallel",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:api": "cypress run --env grepTags=@api",
    "test:integration": "cypress run --env grepTags=#integration",
    "test:staging": "cypress run --env grepTags=#staging",
    "test:prod": "cypress run --env grepTags=#prod",
    "test:parallel": "npm run cy:parallel",
    "lint": "eslint 'cypress/**/*.js' cypress.config.js"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "cypress": "^13.15.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-parallel": "^0.14.0",
    "cypress-plugin-steps": "^1.2.1",
    "dotenv": "^18.0.10",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^3.5.0"
  },
  "license": "MIT"
}
